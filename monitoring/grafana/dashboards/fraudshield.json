    {
      "id": 9,
      "title": "Produced vs scored (tx/s)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(producer_messages_total[1m]))",
          "legendFormat": "produced",
          "refId": "A"
