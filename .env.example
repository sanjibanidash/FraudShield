# Copy to .env  (cp .env.example .env). Everything has a safe default for local use.

# --- images (local build by default; on the cloud VM the CD pipeline sets these) ---
REGISTRY=fraudshield
IMAGE_TAG=local

# --- secrets: CHANGE THESE on any public server ---
POSTGRES_USER=fraud
POSTGRES_PASSWORD=fraud
POSTGRES_DB=fraudshield
ADMIN_TOKEN=change-me
DASHBOARD_USER=admin
# empty = no login (local only!)
DASHBOARD_PASSWORD=
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
GRAFANA_ANONYMOUS=true

# --- networking: 0.0.0.0 locally; 127.0.0.1 on the cloud VM so Postgres/Kafka/Prometheus are NOT public ---
BIND_ADDR=0.0.0.0
API_PORT=8000
DASHBOARD_PORT=5000
GRAFANA_PORT=3000
PUBLIC_GRAFANA_URL=http://localhost:3000

# --- data / pipeline tuning ---
# used only when data/raw/paysim.csv is absent
SYNTHETIC_ROWS=300000
# downsample legit rows of the real 6.3M-row PaySim for a small VM
MAX_LEGIT_TRAIN_ROWS=600000
# transactions per second replayed into Kafka
PRODUCER_TPS=20
CONSUMER_BATCH_SIZE=100
# seconds between drift checks
MONITOR_INTERVAL=60
# most recent transactions compared with the reference
MONITOR_WINDOW=3000
# batch job every 15 min (demo)...
BATCH_INTERVAL=900
# ...or set "02:00" for a real nightly run (UTC)
BATCH_DAILY_AT=
LOG_LEVEL=INFO

# --- free alert channels (optional, any or all) ---
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
